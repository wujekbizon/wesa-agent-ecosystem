# Lumio Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# --- Network ---
UBUNTU_VM_IP=192.168.1.62
WINDOWS_PC_IP=192.168.1.12

# --- Ollama (on Windows PC, called over LAN) ---
OLLAMA_BASE_URL=http://192.168.1.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TUTOR_MODEL=qwen2.5:latest

# --- infra_manager ---
INFRA_MANAGER_PORT=8766
INFRA_MANAGER_HOST=0.0.0.0

# --- Storage Service ---
STORAGE_PORT=8767
STORAGE_BASE_PATH=/home   # Linux home dir — each user has /home/{username}/materials/

# --- RAG Service ---
RAG_PORT=8768
CHROMA_PERSIST_DIR=/data/chroma

# --- Tutor Service ---
TUTOR_PORT=8769

# --- Time Watcher ---
TIME_WATCHER_PORT=8770
TIME_WATCHER_DATA_DIR=/data/sessions

# --- UI Service ---
UI_PORT=3000

# --- WESA Web Monitor (on Windows PC) ---
# infra_manager LAN URL — web monitor reads this to proxy infra requests
LUMIO_INFRA_MANAGER_URL=http://192.168.1.50:8766
